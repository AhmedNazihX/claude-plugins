{
  "checks": [
    {
      "command": "python3 accio/tests/run_tests.py",
      "glob": "accio/**"
    },
    {
      "command": "node --test 'accio/tests/workflow/**/*.test.mjs'",
      "glob": "accio/**"
    },
    {
      "command": "bash git-guardrails/tests/test-guards.sh",
      "glob": "git-guardrails/**"
    }
  ],
  "agent_allow": [
    "claude --plugin-dir ./accio plugin details accio",
    "claude plugin validate accio"
  ],
  "risky_paths": [
    "**/auth/**",
    "**/payments/**",
    "**/migrations/**",
    "**/*secret*",
    ".github/workflows/**",
    "accio/bin/accio_lib/policy.py",
    "accio/bin/accio_lib/bashpolicy.py",
    "accio/bin/accio_lib/shellpaths.py",
    "accio/bin/accio_lib/pushguard.py",
    "accio/hooks/**",
    "git-guardrails/hooks/**"
  ],
  "snapshot_skip": [
    ".remember/**"
  ],
  "breaker": {
    "command": "case {file} in *.mjs) node --test {file} ;; *) PYTHONPATH=accio/bin:accio/tests python3 {file} ;; esac"
  }
}
