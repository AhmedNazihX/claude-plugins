+def paginate(items, page, size):
+    """Return the items of page `page` (from 1). The last page holds the remainder; out of range gives []."""
+    pages = -(-len(items) // size)
+    if page < 1 or page > pages:
+        return []
+    start = (page - 1) * size
+    return items[start:start + size]
