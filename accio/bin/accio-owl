#!/usr/bin/env python3
"""accio-owl: apply owl's batch answer (DESIGN § 3.5; S-022).

  check [answers]                         check the answers; print the accepted stories in merge order
  close [answers] [--merged <ID> ...] [--culprit <ID> <failure>]
                                          after accio-merge: apply every answer, fold the build's statuses into the
                                          story files, write the iteration's outcome and commit it
  push-ok                                 write the one-time push token for the base branch's head

answers: --accept <ID>, --reject <ID> <reason>, --drop <ID> <reason>, --answer <ID> <text>,
         --allow <ID> <command> (from now on), --allow-once <ID> <command> (the next build only); an allowed
         command answers the blocked story that asked for it
         --widen <ID> <path> (repeatable): add a path an answer or reject reason names to that story's files
"""
import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from accio_lib import board, config, ledger, merge, owl, paths, runlock, story, storyfiles  # noqa: E402


def _answers(args):
    pairs = lambda items: tuple((sid, text) for sid, text in items)  # noqa: E731
    return owl.Answers(accept=tuple(args.accept), reject=pairs(args.reject), drop=pairs(args.drop),
                       answer=pairs(args.answer), allow=pairs(args.allow), allow_once=pairs(args.allow_once),
                       widen=pairs(args.widen))


def _add_answers(parser):
    parser.add_argument("--accept", action="append", default=[])
    for name in ("reject", "drop", "answer", "allow", "allow-once", "widen"):
        parser.add_argument(f"--{name}", action="append", nargs=2, default=[], metavar=("ID", "TEXT"))


def run(args, accio):
    if args.command == "push-ok":
        return owl.push_ok(accio, config.load(accio)["base_branch"])
    if args.command == "check":
        stories = board.load_stories(accio)
        return {"accept": list(owl.check(stories, board.statuses(stories, board.read_overrides(accio)),
                                          _answers(args), accio.parent))}
    culprit = tuple(args.culprit) if args.culprit else None
    return owl.close(accio, _answers(args), config.load(accio)["base_branch"], tuple(args.merged), culprit)


def main(argv=None):
    parser = argparse.ArgumentParser(prog="accio-owl", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    commands = parser.add_subparsers(dest="command", required=True)
    _add_answers(commands.add_parser("check"))
    close = commands.add_parser("close")
    _add_answers(close)
    close.add_argument("--merged", action="append", default=[])
    close.add_argument("--culprit", nargs=2, metavar=("ID", "FAILURE"))
    commands.add_parser("push-ok")
    args = parser.parse_args(argv)
    try:
        accio = paths.accio_dir()
        if accio is None:
            raise owl.OwlError("no .accio/ folder in this repo; run accio's setup first")
        print(json.dumps(run(args, accio), indent=2))
    except (owl.OwlError, board.BoardError, config.ConfigError, ledger.LedgerError, merge.MergeError,
            runlock.LockError, story.StoryError, storyfiles.WriteError) as error:
        print(f"accio-owl: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
