#!/usr/bin/env python3
"""accio-summary --run <transcript-dir> [--run ...] | --latest: write .accio/run/owl.md for the review (DESIGN § 3.5).

--latest takes the brew runs since the newest iteration was planned (accio_lib.runs); with none, costs are unknown.
"""
import argparse
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from accio_lib import board, config, cost, paths, plan, runlock, runs, summary  # noqa: E402


def _planned_at(accio):
    """When the newest iteration file was written (0 when there is none)."""
    return max((path.stat().st_mtime for _, path in plan.iterations(accio)), default=0.0)


def main(argv=None):
    parser = argparse.ArgumentParser(prog="accio-summary", description=__doc__)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument("--run", action="append", type=pathlib.Path)
    source.add_argument("--latest", action="store_true")
    args = parser.parse_args(argv)
    try:
        accio = paths.accio_dir()
        if accio is None:
            raise board.BoardError("no .accio/ folder in this repo; run accio's setup first")
        if runlock.is_held(accio / "run"):
            raise board.BoardError("a build is running (run/brew.lock); review it after it ends")
        stories = board.load_stories(accio)
        status = board.statuses(stories, board.read_overrides(accio))
        shown = [sid for sid in stories if status[sid] in ("review", "blocked")]
        budgets = config.load(accio)["budgets"]
        run_dirs = args.run or runs.brew_runs(accio.parent, since=_planned_at(accio))
        costs = cost.report(run_dirs, {sid: cost.budget_for(stories[sid], budgets) for sid in shown})["stories"]
        target = accio / "run" / "owl.md"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(summary.render(stories, status, accio / "run", costs), encoding="utf-8")
    except (board.BoardError, config.ConfigError) as error:
        print(f"accio-summary: {error}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"accio-summary: cannot write the summary: {error}", file=sys.stderr)
        return 1
    print(target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
