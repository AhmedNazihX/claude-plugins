#!/usr/bin/env python3
"""accio-board: the story board (DESIGN § 4.6).

  init                  set accio up in this repo: .accio/ (config.json, stories/), and git ignores .accio/run/
  record-design         commit .accio/design.md with the setup files (wand)
  new                   print the next free story id
  move <ID> <status>    record a status in run/status.json and refresh the run lock
  ready [--json] [--resume]  the ready stories in dependency order, with stacked children; --resume (at a
                        build's load) puts first the stories a crash left in doing, with where they resume
  board [--print]       regenerate .accio/board.md (--print: show it, write nothing)
  status                one-line summary of the columns
  plan [--json]         the next iteration's proposal: eligible stories (deps done, or stacked within
                        stack_depth), held ones and why, and stories whose dep was dropped (prophecy)
  go <ID>... [--track <ID>=<track>] [--also <story file>]   make them exactly the next iteration: status
                        ready in the story files, iterations/<N>.md and board.md, committed with any --also
                        story files (prophecy, on "go")
  record <story file>...  after sort: check every story, regenerate board.md and commit those stories with it
  lock / unlock         take or release the build's run lock
  next [--json]         the one next step (wand, sort, prophecy, brew, owl, wait or done), whether it runs
                        on its own (auto), and the plain sentence
  refresh               mark the running build as alive (every brew step calls it)
"""
import argparse
import json
import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from accio_lib import backlog, board, config, design, nextstep, paths, plan, runlock, story  # noqa: E402


def _accio():
    accio = paths.accio_dir()
    if accio is None:
        raise board.BoardError("no .accio/ folder in this repo; run accio's setup first")
    return accio


def _loaded(accio):
    stories = board.load_stories(accio)
    return stories, board.statuses(stories, board.read_overrides(accio))


def cmd_new(_args, accio):
    if runlock.is_held(board.run_dir(accio)):  # sort's first command: no story file is written during a build
        raise board.BoardError("a build is running (run/brew.lock); write stories after it ends")
    print(board.next_id(accio))


def cmd_move(args, accio):
    board.move(accio, board.load_stories(accio), args.id, args.status)


def cmd_ready(args, accio):
    stories, status = _loaded(accio)
    settings = config.load(accio)
    board.require_checks(settings)
    batch = [{**item, "resume": None} for item in board.ready_batch(stories, status, settings["stack_depth"])]
    if args.resume:
        batch = [*board.resumed(stories, status, paths.main_root(), accio, settings["base_branch"]), *batch]
    if args.json:
        print(json.dumps({"wip": settings["wip"], "stories": batch}, indent=2))
    else:
        for item in batch:
            print(f"{item['id']}  level {item['level']}  {item['title']}")


def cmd_plan(args, accio):
    stories, status = _loaded(accio)
    proposal = plan.propose(stories, status, config.load(accio))
    planned = plan.open_iteration(accio, status)
    reply = {"iteration": planned or plan.next_iteration(accio), "open_iteration": planned, **proposal}
    print(json.dumps(reply, indent=2) if args.json else plan.describe(proposal))


def cmd_go(args, accio):
    tracks = {}
    for override in args.track:
        story_id, separator, track = override.partition("=")
        if not separator:
            raise plan.PlanError(f"a track override looks like S-012=quick, got {override!r}")
        tracks[story_id] = track
    print(json.dumps(plan.go(accio, config.load(accio), args.ids, tracks, args.also), indent=2))


def cmd_record_design(_args, accio):
    print(json.dumps(design.record_design(accio), indent=2))


def cmd_record(args, accio):
    print(json.dumps(backlog.record(accio, args.files), indent=2))


def cmd_board(args, accio):
    stories, status = _loaded(accio)
    if args.print:  # map: show it without touching board.md, which is committed (a build must see main unchanged)
        print(board.render(stories, status))
        return
    path = accio / board.BOARD_NAME
    try:
        path.write_text(board.render(stories, status), encoding="utf-8")
    except OSError as error:
        raise board.BoardError(f"cannot write {path}: {error}") from error


def cmd_status(_args, accio):
    _, status = _loaded(accio)
    print(board.summary(status))


def cmd_next(args, accio):
    stories, status = _loaded(accio)
    dropped = plan.propose(stories, status, config.load(accio))["dropped_deps"] if "backlog" in status.values() else ()
    reply = nextstep.next_step(accio, status, bool(os.environ.get("CLAUDE_CODE_DISABLE_WORKFLOWS")), dropped)
    print(json.dumps(reply, indent=2) if args.json else reply["sentence"])


def cmd_lock(_args, accio):
    note = runlock.take(board.run_dir(accio))
    if note:
        print(note)


def cmd_unlock(_args, accio):
    runlock.release(board.run_dir(accio))


def cmd_refresh(_args, accio):
    runlock.refresh(board.run_dir(accio))


def parser():
    top = argparse.ArgumentParser(prog="accio-board", description="accio's story board")
    commands = top.add_subparsers(dest="command", required=True)
    commands.add_parser("new").set_defaults(run=cmd_new)
    move = commands.add_parser("move")
    move.add_argument("id")
    move.add_argument("status")
    move.set_defaults(run=cmd_move)
    ready = commands.add_parser("ready")
    ready.add_argument("--json", action="store_true")
    ready.add_argument("--resume", action="store_true", help="also list stories a crash left in doing (at load)")
    ready.set_defaults(run=cmd_ready)
    plan_parser = commands.add_parser("plan")
    plan_parser.add_argument("--json", action="store_true")
    plan_parser.set_defaults(run=cmd_plan)
    go = commands.add_parser("go")
    go.add_argument("ids", nargs="+")
    go.add_argument("--track", action="append", default=[])
    go.add_argument("--also", action="append", default=[], help="a story file the skill edited, to commit too")
    go.set_defaults(run=cmd_go)
    next_parser = commands.add_parser("next")
    next_parser.add_argument("--json", action="store_true")
    next_parser.set_defaults(run=cmd_next)
    commands.add_parser("init")
    commands.add_parser("record-design").set_defaults(run=cmd_record_design)
    record = commands.add_parser("record")
    record.add_argument("files", nargs="+")
    record.set_defaults(run=cmd_record)
    board_parser = commands.add_parser("board")
    board_parser.add_argument("--print", action="store_true", help="print the board instead of writing board.md")
    board_parser.set_defaults(run=cmd_board)
    for name, run in (("status", cmd_status), ("lock", cmd_lock), ("unlock", cmd_unlock), ("refresh", cmd_refresh)):
        commands.add_parser(name).set_defaults(run=run)
    return top


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        if args.command == "init":  # before there is an .accio/ to find
            print(json.dumps(design.init(), indent=2))
            return 0
        args.run(args, _accio())
    except (board.BoardError, config.ConfigError, runlock.LockError, plan.PlanError, story.StoryError,
            backlog.BacklogError, design.DesignError) as error:
        print(f"accio-board: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
