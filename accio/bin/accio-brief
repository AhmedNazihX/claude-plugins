#!/usr/bin/env python3
"""accio-brief <ID> [--parent <branch>] [--fix <findings-file> ... | --review [--since <commit>]]
(DESIGN § 3.4 steps 1, 4 and 6, § 12.3).

Without --fix: create or reuse the story's worktree and branch, rebase it, and write run/<ID>/brief.md.
With --fix: write run/<ID>/fix-brief.md listing only the given findings; the worktree is not touched.
Prints {"worktree", "brief", "base"} as JSON (portkey's reply).
With --review: write run/<ID>/review.diff and review-package.md for the reviewers; --since <commit> limits the diff
to a fix round's. Prints {"package", "diff", "head", "risky"}; the worktree is not touched.
With --review --fix-branch <branch> --acceptance <file> (no ID): the same package for a direct fix on a branch that
is not a story, with the acceptance list in place of the DoD and a findings path for each reviewer.
"""
import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from accio_lib import brief, checks, config, globs, paths, review, runlock, story  # noqa: E402


def _existing_worktree(main, story_id):
    worktree = paths.worktree_root(main) / story_id
    if not brief.has_worktree(main, story_id):
        raise brief.BriefError(f"the worktree {worktree} doesn't exist; run `accio-brief {story_id}` first")
    return worktree


def run(args):
    main, accio = paths.main_root(), paths.accio_dir()
    if main is None or accio is None:
        raise brief.BriefError("no .accio/ folder in this repo; run accio's setup first")
    if args.fix_branch:
        return review.package_fix(accio, main, args.fix_branch, args.acceptance, config.load(accio))
    if not story.STORY_ID.match(args.id):
        raise brief.BriefError(f"a story id looks like S-012, got {args.id!r}")
    story_path = accio / "stories" / f"{args.id}.md"
    if not story_path.is_file():
        raise brief.BriefError(f"there is no story {args.id} ({story_path})")
    parsed = story.parse(story_path)
    if parsed.meta["id"] != args.id:
        raise brief.BriefError(f"{story_path} says its id is {parsed.meta['id']}, not {args.id}")
    settings = config.load(accio)
    onto = brief.resolve_onto(main, settings["base_branch"], args.parent)
    run_dir = accio / "run" / args.id
    if args.review:
        return review.package(accio, parsed, _existing_worktree(main, args.id), settings, args.since)
    runlock.release_claim(accio / "run", args.id)  # the house-elf of this brief claims afresh (S-015)
    if args.fix:
        worktree = _existing_worktree(main, args.id)
        text = brief.render_fix(parsed, accio, worktree, brief.read_findings(args.fix))
        target = brief.write_file(run_dir / "fix-brief.md", text)
    else:
        worktree, notes = brief.prepare_worktree(main, run_dir, args.id, onto)
        (run_dir / checks.SNAPSHOT_NAME).unlink(missing_ok=True)  # portkey snapshots the main checkout afresh
        files = parsed.meta.get("files", ())
        text = brief.render_brief(parsed, accio, worktree, onto, brief.scoped_checks(settings["checks"], files),
                                  brief.existing_files(main, onto, files), notes)
        target = brief.write_file(run_dir / "brief.md", text)
    return {"worktree": str(worktree), "brief": str(target), "base": onto}


def main(argv=None):
    parser = argparse.ArgumentParser(prog="accio-brief", description=__doc__)
    parser.add_argument("id", nargs="?")
    parser.add_argument("--fix-branch")
    parser.add_argument("--acceptance", type=pathlib.Path)
    parser.add_argument("--parent")
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--fix", action="append", type=pathlib.Path, default=[])
    modes.add_argument("--review", action="store_true")
    parser.add_argument("--since")
    args = parser.parse_args(argv)
    if args.since and not args.review:
        parser.error("--since goes with --review")
    if args.fix_branch or args.acceptance:
        if not (args.review and args.fix_branch and args.acceptance) or args.id or args.since or args.parent:
            parser.error("a direct fix review is: --review --fix-branch <branch> --acceptance <file>, with no story id")
    elif not args.id:
        parser.error("a story id is required")
    try:
        print(json.dumps(run(args)))
    except (brief.BriefError, story.StoryError, config.ConfigError, globs.GlobError, runlock.LockError) as error:
        print(f"accio-brief: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
