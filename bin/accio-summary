#!/usr/bin/env python3
"""accio-summary --run <transcript-dir> [--run ...]: write .accio/run/owl.md for the review (DESIGN § 3.5)."""
import argparse
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from accio_lib import board, config, cost, paths, summary  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(prog="accio-summary", description=__doc__)
    parser.add_argument("--run", action="append", type=pathlib.Path, required=True)
    args = parser.parse_args(argv)
    try:
        accio = paths.accio_dir()
        if accio is None:
            raise board.BoardError("no .accio/ folder in this repo; run accio's setup first")
        stories = board.load_stories(accio)
        status = board.statuses(stories, board.read_overrides(accio))
        shown = [sid for sid in stories if status[sid] in ("review", "blocked")]
        budgets = config.load(accio)["budgets"]
        costs = cost.report(args.run, {sid: cost.budget_for(stories[sid], budgets) for sid in shown})["stories"]
        target = accio / "run" / "owl.md"
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(summary.render(stories, status, accio / "run", costs), encoding="utf-8")
    except (board.BoardError, config.ConfigError) as error:
        print(f"accio-summary: {error}", file=sys.stderr)
        return 1
    except OSError as error:
        print(f"accio-summary: cannot write the summary: {error}", file=sys.stderr)
        return 1
    print(target)
    return 0


if __name__ == "__main__":
    sys.exit(main())
