#!/usr/bin/env python3
"""accio-hooks: accio's native git hooks (DESIGN § 4.5).

  install                          add accio's pre-commit and pre-push hooks, chaining into husky; for lefthook or
                                   the pre-commit framework, print a snippet and edit nothing
  verify                           report a missing or unrunnable hook, an inactive hooks folder or an early exit
                                   before accio's lines (and rewrite a stale path)
  uninstall                        remove only accio's marked lines
  run <hook> --root <repo> [...]   what the installed hooks call; silent when <repo> has no .accio/
"""
import argparse
import os
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from accio_lib import config, githooks, paths, pushguard  # noqa: E402

SCRIPT = pathlib.Path(__file__).resolve()


def _print(lines, stream=sys.stdout):
    for line in lines:
        print(line, file=stream)


def _setup(command):
    root = paths.main_root()
    if root is None or paths.accio_dir() is None:
        raise githooks.HooksError("no .accio/ folder in this repo; run accio's setup first")
    if command == "install":
        notes, problems = githooks.install(root, SCRIPT)
    elif command == "uninstall":
        notes, problems = githooks.uninstall(root) or ("accio-hooks: no accio lines found",), ()
    else:
        problems, notes = githooks.verify(root, SCRIPT)
    _print(notes)
    _print(problems)
    return 1 if problems else 0


def _run(hook, root_arg):
    """The repo comes from the hook line, never from where git was pointed (`--work-tree`, `GIT_DIR`)."""
    root = pathlib.Path(root_arg) if root_arg else paths.main_root()
    accio = root / paths.ACCIO_DIR_NAME if root else None
    if accio is None or not accio.is_dir():
        return 0
    if hook == "pre-commit":
        messages = pushguard.run_pre_commit(pathlib.Path.cwd())
        _print(messages, sys.stderr)
        return 1 if messages else 0
    pushes = pushguard.parse_pushes(sys.stdin.read())
    allowed, messages = pushguard.check_push(root, accio, pathlib.Path.cwd(), pushes, os.environ)
    _print(messages, sys.stderr)
    return 0 if allowed else 1


def main(argv=None):
    parser = argparse.ArgumentParser(prog="accio-hooks", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("command", choices=("install", "verify", "uninstall", "run"))
    parser.add_argument("hook", nargs="?", choices=githooks.HOOKS)
    parser.add_argument("--root", help="the repo the hook belongs to (written into the hook by install)")
    parser.add_argument("hook_args", nargs="*", help="what git passes to the hook (unused)")
    args, _ = parser.parse_known_args(argv)
    if (args.command == "run") != (args.hook is not None):
        parser.error("give a hook name with `run`, and only with `run`")
    try:
        return _run(args.hook, args.root) if args.command == "run" else _setup(args.command)
    except (githooks.HooksError, config.ConfigError) as error:
        print(f"accio-hooks: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
