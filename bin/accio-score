#!/usr/bin/env python3
"""accio-score <story-file> [--json]: the story's complexity score, track and split flag (DESIGN § 3.2)."""
import argparse
import json
import pathlib
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))

from accio_lib import config, globs, paths, score, story  # noqa: E402


def main(argv=None):
    parser = argparse.ArgumentParser(prog="accio-score", description=__doc__)
    parser.add_argument("story", type=pathlib.Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)
    try:
        parsed = story.parse(args.story)
        accio = paths.accio_dir(args.story.resolve().parent)
        risky_paths = (config.load(accio) if accio else config.DEFAULTS)["risky_paths"]
    except (story.StoryError, config.ConfigError) as error:
        print(f"accio-score: {error}", file=sys.stderr)
        return 1
    try:
        result = score.assess(parsed.meta.get("files", ()), parsed.meta.get("risk"), risky_paths)
    except globs.GlobError as error:
        print(f"accio-score: {args.story}: {error}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2) if args.json else score.describe(result))
    return 0


if __name__ == "__main__":
    sys.exit(main())
